# ─────────────────────────────────────────────────────────────
# ChikitAI v5.0 — Environment Configuration (Bolna Edition)
# Copy to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Bolna AI ──────────────────────────────────────────────────
# Found at: platform.bolna.ai → Developer → API Keys
BOLNA_API_KEY=your_bolna_api_key_here

# Found at: platform.bolna.ai → Your Agent → Overview
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Optional: your purchased Indian +91 number from Bolna
# Leave blank to use Bolna's shared number pool
BOLNA_FROM_NUMBER=

# ── ngrok (tunnel for local dev) ──────────────────────────────
# Found at: dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ── Server ────────────────────────────────────────────────────
PORT=8000
DB_PATH=hospital_db.json
